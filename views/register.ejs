<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Crear cuenta - Kirkversario</title>
</head>

<body>

    <h1>Crear cuenta</h1>

    <form method="POST" action="/register">

        <div>
            <label for="username">
                Nombre de usuario
            </label>

            <input
                type="text"
                id="username"
                name="username"
                required
            >
        </div>

        <div>
            <label for="password">
                Contraseña
            </label>

            <input
                type="password"
                id="password"
                name="password"
                required
            >
        </div>

        <button type="submit">
            Crear cuenta
        </button>

    </form>

    <p>
        ¿Ya tienes cuenta?
        <a href="/login">Iniciar sesión</a>
    </p>

</body>

</html>