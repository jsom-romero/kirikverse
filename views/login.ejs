<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Iniciar sesión - Kirkversario</title>
</head>

<body>

    <h1>Iniciar sesión</h1>

    <form method="POST" action="/login">

        <div>
            <label for="username">
                Nombre de usuario
            </label>

            <input
                type="text"
                id="username"
                name="username"
                required
            >
        </div>

        <div>
            <label for="password">
                Contraseña
            </label>

            <input
                type="password"
                id="password"
                name="password"
                required
            >
        </div>

        <button type="submit">
            Iniciar sesión
        </button>

    </form>

    <p>
        ¿No tienes cuenta?
        <a href="/register">Crear cuenta</a>
    </p>

</body>

</html>